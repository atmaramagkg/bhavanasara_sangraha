><column index="4" value="64"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="period_nodes" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="65"/><column index="3" value="87"/><column index="4" value="77"/><column index="5" value="69"/><column index="6" value="62"/><column index="7" value="69"/><column index="8" value="223"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sections" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="98"/><column index="3" value="69"/><column index="4" value="215"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="translations" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="79"/><column index="2" value="279"/><column index="3" value="287"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="verses" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="68"/><column index="3" value="69"/><column index="4" value="60"/><column index="6" value="69"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ==========================================
-- 1. CREATE CONTENT TABLES
-- ==========================================

CREATE TABLE IF NOT EXISTS books (
    id INTEGER PRIMARY KEY,
    slug TEXT NOT NULL UNIQUE,
    title_key TEXT NOT NULL,
    author_key TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS period_nodes (
    id INTEGER PRIMARY KEY,
    parent_id INTEGER REFERENCES period_nodes(id),
    code TEXT NOT NULL UNIQUE,
    period_type TEXT NOT NULL DEFAULT 'main', -- 'main' or 'sub'
    time_start TEXT,
    time_end TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    name_key TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS sections (
    id INTEGER PRIMARY KEY,
    period_node_id INTEGER NOT NULL REFERENCES period_nodes(id),
    sort_order INTEGER NOT NULL,
    title_key TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS verses (
    id INTEGER PRIMARY KEY,
    section_id INTEGER NOT NULL REFERENCES sections(id),
    sort_order INTEGER NOT NULL,
    text_key TEXT NOT NULL,
    source_book_id INTEGER REFERENCES books(id),
    source_ref TEXT -- e.g., '1.10' or 'Govinda-līlāmṛta 1.10'
);

-- ==========================================
-- 2. SEED SOURCE BOOKS (Translations &amp; Data)
-- ==========================================

-- Insert English translations for Book Titles and Authors
