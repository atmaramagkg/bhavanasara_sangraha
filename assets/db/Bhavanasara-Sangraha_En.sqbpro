-- ==========================================
-- 3. SEED PERIOD NODES (Main &amp; Subperiods)
-- ==========================================

-- Insert English translations for Chapter 1 Subperiods
INSERT OR IGNORE INTO translations (language_id, translation_key, translated_text) VALUES
(1, 'period_node.nishanta_1.name', 'Niśānta-līlā (3:36 a.m.—4:24 a.m.)'),
(1, 'period_node.nishanta_2.name', 'Niśānta-līlā (4:24 a.m.—5:36 a.m.)'),
(1, 'period_node.nishanta_3.name', 'Niśānta-līlā (5:36 a.m.—6:00 a.m.)');

-- Insert the 8 Main Periods (Linking to the translations we created in Step 1)
INSERT OR IGNORE INTO period_nodes (id, parent_id, code, period_type, time_start, time_end, sort_order, name_key) VALUES
(1, NULL, 'nishanta', 'main', '03:36', '06:00', 1, 'period.nishanta.name'),
