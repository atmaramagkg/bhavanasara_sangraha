(6, NULL, 'sayahna', 'main', '18:00', '20:24', 6, 'period.sayahna.name'),
(7, NULL, 'pradosha', 'main', '20:24', '22:48', 7, 'period.pradosha.name'),
(8, NULL, 'nisha', 'main', '22:48', '03:36', 8, 'period.nisha.name');

-- Insert Chapter 1 Subperiods (parent_id = 1, which is Niśānta-līlā)
INSERT OR IGNORE INTO period_nodes (id, parent_id, code, period_type, time_start, time_end, sort_order, name_key) VALUES
(9, 1, 'nishanta_1', 'sub', '03:36', '04:24', 1, 'period_node.nishanta_1.name'),
(10, 1, 'nishanta_2', 'sub', '04:24', '05:36', 2, 'period_node.nishanta_2.name'),
(11, 1, 'nishanta_3', 'sub', '05:36', '06:00', 3, 'period_node.nishanta_3.name');

-- ==========================================
-- 4. SEED SECTIONS (Topics inside Subperiods)
-- ==========================================

-- Insert English translations for Chapter 1 Sections
INSERT OR IGNORE INTO translations (language_id, translation_key, translated_text) VALUES
(1, 'section.nishanta_1.1.title', 'The sakhīs’ morning services'),
